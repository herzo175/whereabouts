{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#check:ci": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["VITE_CANONICAL_ORIGIN"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_CANONICAL_ORIGIN"]
    },
    "test": {
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "test:e2e": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "content:validate": {
      "cache": false,
      "env": ["PUBLICATION_CEILING"]
    },
    "content:generate": {
      "cache": false,
      "passThroughEnv": [
        "OPENROUTER_API_KEY",
        "WIKIMEDIA_USER_AGENT",
        "WHEREABOUTS_MODEL"
      ]
    },
    "content:generate-range": {
      "cache": false,
      "passThroughEnv": [
        "OPENROUTER_API_KEY",
        "WIKIMEDIA_USER_AGENT",
        "WHEREABOUTS_MODEL"
      ]
    },
    "content:review": {
      "cache": false
    },
    "content:review-range": {
      "cache": false
    }
  }
}
