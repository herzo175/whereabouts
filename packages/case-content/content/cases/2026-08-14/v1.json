  "clues": [
    {
      "id": "clue-1",
      "text": "This landmark commands a historic strait where Europe and Asia face each other across a narrow waterway.",
      "sourceIds": ["britannica-hagia"]
    },
    {
      "id": "clue-2",
      "text": "It began as a sixth-century imperial Christian church, built under Emperor Justinian I.",
      "sourceIds": ["britannica-hagia"]
    },
    {
      "id": "clue-3",
      "text": "Its immense central dome became a celebrated model for later sacred architecture in the region.",
      "sourceIds": ["unesco-historic-areas"]
    },
    {
      "id": "clue-4",
      "text": "After a fifteenth-century conquest, the building served for centuries as a mosque and gained minarets.",
      "sourceIds": ["britannica-hagia"]
    },
    {
      "id": "clue-5",
      "text": "Mosaics, calligraphic roundels, and changing religious functions make its interior a record of layered history.",
      "sourceIds": ["unesco-historic-areas"]
    },
    {
      "id": "clue-6",
      "text": "The site stands in a peninsula district alongside an imperial palace complex and a major blue-tiled mosque.",
      "sourceIds": ["unesco-historic-areas"]
    }
  ],
