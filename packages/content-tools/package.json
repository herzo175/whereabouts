{
  "name": "@whereabouts/content-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "content:generate": "tsx src/generate-case.ts",
    "content:generate-range": "tsx src/generate-range.ts",
    "content:prepare-buffer": "tsx src/generate-range.ts --missing-only",
    "content:validate": "tsx src/validate-all.ts",
    "content:review": "tsx src/review-case.ts",
    "content:review-range": "tsx src/review-range.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@whereabouts/case-content": "workspace:*",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.20.6",
    "vitest": "4.0.18"
  }
}
